@page "/quiz-list"
@rendermode InteractiveServer
@using Test.Models
@inject TestDbContext DbContext
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AuthenticatedOnly")]
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<QuizList> Logger
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Available Quizzes | Test</PageTitle>

<div class="flex flex-col items-center justify-center min-h-screen p-4">

    <h1 class="text-3xl font-bold mb-4">Available Quizzes</h1>
    
    <hr class="w-48 h-0.5 mx-auto bg-slate-900 rounded-sm mb-8">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded mb-6 max-w-3xl w-full text-center">
            <span class="">@errorMessage</span>
        </div>
    }

    <div class="w-full max-w-3xl">
        @if (loading)
        {
            <div class="flex items-center justify-center">
                <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-slate-900"></div>
            </div>
        }
        else if (!quizzes.Any())
        {
            <div class="text-center py-8">
                <p class="text-xl text-gray-600">No quizzes available at the moment</p>
            </div>
        }
        else
        {
            <div class="grid gap-6 md:grid-cols-2">
                @foreach (var quiz in quizzes)
                {
                    bool maxAttemptsReached = quizAttemptCounts.TryGetValue(quiz.QuizId, out int attempts) && attempts >= 2;
                    
                    <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
                        <h2 class="text-xl font-bold mb-2">@quiz.QuizName</h2>
                        <p class="text-gray-600 mb-4 line-clamp-2">@quiz.QuizDescription</p>
                        <div class="flex justify-between items-center">
                            <div class="flex flex-col">
                                <span class="text-sm text-gray-500">
                                    @questionCounts[quiz.QuizId] questions
                                </span>
                                <span class="text-sm @(maxAttemptsReached ? "text-red-500 font-medium" : "text-gray-500")">
                                    @(attempts) / 2 attempts used
                                </span>
                            </div>
                            
                            @if (!maxAttemptsReached)
                            {
                                <button @onclick="() => Start(quiz.QuizId)"
                                    class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2">
                                    Start Quiz
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>