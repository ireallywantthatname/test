@page "/register"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<IdentityUser> UserManager
@inject NavigationManager Navigation
@inject SignInManager<IdentityUser> SignInManager
@inject ILogger<Register> Logger
@using Test.Models
@inject TestDbContext DbContext

<PageTitle>Register | Test</PageTitle>

<div class="flex flex-col items-center justify-center min-h-screen p-12">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold m-2">Register</h1>
        <hr class="w-48 h-0.5 mx-auto bg-slate-950 rounded-sm">
    </div>

    @if (errors.Any())
    {
        <div class="w-full max-w-md bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            @foreach (var error in errors)
            {
                <p class="text-sm">@error</p>
            }
        </div>
    }

    @if (Role == "student")
    {
        <div class="w-sm sm:w-sm md:w-md">
            <EditForm Model="student" OnValidSubmit="HandleStudentRegistration" FormName="StudentRegistration" Enhance>
                <DataAnnotationsValidator />

                <div class="mb-6">
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                    <InputText id="username"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="student.Username" />
                    <ValidationMessage For="@(() => student.Username)" class="text-sm text-red-600 mt-1" />
                </div>

                <div class="mb-6">
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <InputText id="password" type="password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="student.Password" />
                    <ValidationMessage For="@(() => student.Password)" class="text-sm text-red-600 mt-1" />
                </div>

                <div class="mb-6">
                    <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-2">Confirm
                        Password</label>
                    <InputText id="confirmPassword" type="password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="studentConfirmPassword" />
                    @if (passwordError)
                    {
                        <p class="text-sm text-red-600 mt-1">Passwords do not match</p>
                    }
                </div>

                <button type="submit"
                    class="w-full relative bottom-0 left-auto right-auto items-center bg-slate-900 text-white py-2 px-4 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                    Register
                </button>
            </EditForm>
            <div class="mt-4 text-center">
                <p class="text-sm text-gray-600">
                    Already have an account? <a href="/login" class="text-slate-800 hover:underline">Login here</a>
                </p>
            </div>
        </div>
    }
    else if (Role == "educator")
    {
        <div class="w-sm sm:w-sm md:w-md">
            <EditForm Model="educator" OnValidSubmit="HandleEducatorRegistration" FormName="EducatorRegistration" Enhance>
                <DataAnnotationsValidator />

                <div class="mb-6">
                    <label for="educatorUsername" class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                    <InputText id="educatorUsername"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="educator.Username" />
                    <ValidationMessage For="@(() => educator.Username)" class="text-sm text-red-600 mt-1" />
                </div>

                <div class="mb-6">
                    <label for="educatorPassword" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <InputText id="educatorPassword" type="password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="educator.Password" />
                    <ValidationMessage For="@(() => educator.Password)" class="text-sm text-red-600 mt-1" />
                </div>

                <div class="mb-6">
                    <label for="educatorConfirmPassword" class="block text-sm font-medium text-gray-700 mb-2">Confirm
                        Password</label>
                    <InputText id="educatorConfirmPassword" type="password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="educatorConfirmPassword" />
                    @if (educatorPasswordError)
                    {
                        <p class="text-sm text-red-600 mt-1">Passwords do not match</p>
                    }
                </div>

                <button type="submit"
                    class="w-full relative bottom-0 left-auto right-auto items-center bg-slate-900 text-white py-2 px-4 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                    Register
                </button>
            </EditForm>
            <div class="mt-4 text-center">
                <p class="text-sm text-gray-600">
                    Already have an account? <a href="/login" class="text-slate-800 hover:underline">Login here</a>
                </p>
            </div>
        </div>
    }
    else
    {
        Navigation.NavigateTo("/");
    }
</div>
