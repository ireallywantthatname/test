@page "/quiz-create"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = "EducatorOnly")]
@inject UserManager<IdentityUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<QuizCreate> Logger

<PageTitle>Create | Test</PageTitle>


<div class="fixed bottom-6 left-1/2 transform -translate-x-1/2 z-50">
    <button @onclick="ValidateAndSave"
        class="px-4 py-2 bg-slate-950 text-white rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200 font-medium shadow-lg">
        Save Quiz
    </button>
</div>

<div class="min-h-screen flex items-center justify-center p-11">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold m-2">Create a quiz</h1>
            <hr class="w-48 h-0.5 mx-auto bg-slate-950 rounded-sm">
        </div>

        @if (summaryErrors.Any() && showValidationErrors)
        {
            <div class="max-w-2xl mx-auto bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-8">
                @foreach (var error in summaryErrors)
                {
                    <p class="text-sm">@error</p>
                }
            </div>
        }

        <!-- Quiz Details Card -->
        <div class="bg-white p-6 rounded-lg w-sm sm:w-sm md:w-md mx-auto">
            <h2 class="text-xl font-semibold mb-6 text-slate-950 text-center">Quiz Details</h2>
            
            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-slate-800 mb-2">Title</label>
                    <input @bind="paper.QuizName"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md  focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        placeholder="Enter quiz title" />
                    @if (string.IsNullOrWhiteSpace(paper.QuizName) && showValidationErrors)
                    {
                        <p class="text-red-600 text-sm mt-1">Quiz title is required</p>
                    }
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                    <textarea @bind="paper.QuizDescription" rows="3"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md  focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        placeholder="Enter quiz description"></textarea>
                    @if (string.IsNullOrWhiteSpace(paper.QuizDescription) && showValidationErrors)
                    {
                        <p class="text-red-600 text-sm mt-1">Quiz description is required</p>
                    }
                </div>
            </div>
        </div>

        <!-- Questions Card -->
        <div class="mb-8">
            <div class="max-w-6xl min-w-sm sm:min-w-sm md:min-w-md text-center p-4 ">
                    <div class="@(questions.Any() ? "grid-cols-1 sm:grid-cols-1 md:grid-cols-2" : "") grid gap-4 place-items-center">
                        @foreach (var (question, index) in questions.Select((q, i) => (q, i)))
                        {
                            <div class="bg-white p-4 rounded-lg w-sm sm:w-sm md:w-md flex flex-col justify-center">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-lg font-medium text-slate-950">@(index + 1)</h3>
                                    <button @onclick="() => RemoveQuestion(question)"
                                        class="text-red-600 border border-red-600 rounded-md hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors duration-200 py-2 px-4 text-sm">
                                        Remove
                                    </button>
                                </div>

                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Question Text</label>
                                        <textarea @bind="question.QuestionBody" rows="3"
                                            class="w-full px-3 py-2 border border-gray-300 rounded-md  focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                                            placeholder="Enter your question"></textarea>
                                        @if (string.IsNullOrWhiteSpace(question.QuestionBody) && showValidationErrors)
                                        {
                                            <p class="text-red-600 text-sm mt-1">Question text is required</p>
                                        }
                                    </div>
                                    
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-2">Difficulty</label>
                                            <select @bind="question.QuestionDifficulty"
                                                class="w-full px-3 py-2 border border-gray-300 rounded-md  focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500">
                                                <option value="easy">Easy</option>
                                                <option value="medium">Medium</option>
                                                <option value="hard">Hard</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-2">Marks</label>
                                            <input type="number" @bind="question.Score" min="0" step="0.5"
                                                class="w-full px-3 py-2 border border-gray-300 rounded-md  focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500" />
                                        </div>
                                    </div>
                                    <div>
                                        <h3 class="text-sm mb-3">Answers</h3>
                                        @foreach (var answer in questionAnswers[question])
                                        {
                                            <div class="flex items-center gap-3 mb-2">
                                                <input @bind="answer.Body" placeholder="Answer text"
                                                    class="flex-grow px-3 py-2 border border-gray-300 rounded-md  focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500" />
                                                <label class="flex items-center gap-2">
                                                    <input type="checkbox" @bind="answer.IsCorrect"
                                                        class="w-4 h-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded" />
                                                    <span class="text-sm text-gray-700">Correct</span>
                                                </label>
                                                <button @onclick="() => RemoveAnswer(question, answer)"
                                                    class="relative right-35 px-3 py-1 text-xs text-red-600 rounded-sm bg-red-50 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors duration-200">
                                                    X
                                                </button>
                                            </div>
                                            @if (string.IsNullOrWhiteSpace(answer.Body) && showValidationErrors)
                                            {
                                                <p class="text-red-600 text-sm">Answer text is required</p>
                                            }
                                        }
                                        @if (!questionAnswers[question].Any(a => a.IsCorrect) && questionAnswers[question].Any() &&
                                            showValidationErrors)
                                        {
                                            <p class="text-red-600 text-sm">At least one correct answer must be selected</p>
                                        }
                                        <button @onclick="() => AddAnswer(question)"
                                            class="mt-2 px-4 py-2 text-sm bg-slate-100 text-slate-700 rounded-md hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
    <button @onclick="AddQuestion"
        class="p-4 w-sm sm:w-sm md:w-md h-full flex flex-col justify-center items-center hover:bg-slate-200 text-slate-700 border-2 border-slate-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">Add Question</button>
                    </div>
            </div>
        </div>
    </div>
</div>