@page "/login"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@using Test.Models
@inject TestDbContext DbContext

<PageTitle>Login | Test</PageTitle>

<div class="flex flex-col items-center justify-center min-h-screen p-4">
    <h1 class="text-3xl font-bold mb-4">Login</h1>
    <hr class="w-48 h-0.5 mx-auto bg-slate-900 rounded-sm mb-8">

    @if (errors.Any())
    {
        <div class="w-full max-w-md bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            @foreach (var error in errors)
            {
                <p class="text-sm">@error</p>
            }
        </div>
    }

    @if (Role == "student")
    {
        <div class="w-full max-w-md">
            <EditForm Model="student" OnValidSubmit="HandleStudentLogin" FormName="StudentRegistration" Enhance>
                <DataAnnotationsValidator />
                @* <div class="bg-red-50 text-red-600 rounded p-3 mb-4">
                    <ValidationSummary />
                </div> *@

                <div class="mb-6">
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                    <InputText id="username"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="student!.Username" />
                    <ValidationMessage For="@(() => student.Username)" class="text-sm text-red-600 mt-1" />
                </div>

                <div class="mb-6">
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <InputText id="password" type="password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="student.Password" />
                    <ValidationMessage For="@(() => student.Password)" class="text-sm text-red-600 mt-1" />
                </div>

                <button type="submit"
                    class="w-full bg-slate-900 text-white py-2 px-4 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                    Student Login
                </button>
            </EditForm>
        </div>
    }
    else if (Role == "educator")
    {
        <div class="w-full max-w-md">
            <EditForm Model="educator" OnValidSubmit="HandleEducatorLogin" FormName="EducatorRegistration" Enhance>
                <DataAnnotationsValidator />
                @* <div class="bg-red-50 text-red-600 rounded p-3 mb-4">
                    <ValidationSummary />
                </div> *@

                <div class="mb-6">
                    <label for="educatorUsername" class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                    <InputText id="educatorUsername"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="educator!.Username" />
                    <ValidationMessage For="@(() => educator.Username)" class="text-sm text-red-600 mt-1" />
                </div>

                <div class="mb-6">
                    <label for="educatorPassword" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <InputText id="educatorPassword" type="password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
                        @bind-Value="educator.Password" />
                    <ValidationMessage For="@(() => educator.Password)" class="text-sm text-red-600 mt-1" />
                </div>

                <button type="submit"
                    class="w-full bg-slate-900 text-white py-2 px-4 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                    Educator Login
                </button>
            </EditForm>
        </div>
    }
    else {
        Navigation.NavigateTo("/");
    }
</div>

@code {
    [Parameter]
    public string? Role { get; set; }

    [SupplyParameterFromForm]
    public Student? student { get; set; } = new Student();

    [SupplyParameterFromForm]
    public Educator? educator { get; set; } = new Educator();

    protected override void OnInitialized()
    {
        student ??= new();
        educator ??= new();
    }

    protected override void OnParametersSet()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("role", out var rolevalue))
        {
            Role = rolevalue.ToString().ToLower();
        }
        else
        {
            Role = null;
        }
    }

    private List<string> errors = new List<string>();

    private async Task HandleStudentLogin()
    {
        errors.Clear();

        try
        {
            Logger.LogInformation("User login attempt for email: {Email}", student!.Username);
            var result = await SignInManager.PasswordSignInAsync(student.Username, student.Password, isPersistent: false, lockoutOnFailure:
            false);

            if (result.Succeeded)
            {
                Logger.LogInformation("User login successful for email: {Email}", student.Username);
                Navigation.NavigateTo("/");
            }
            else
            {
                if (result.IsLockedOut)
                {
                    Logger.LogWarning("User account locked out for email: {Email}", student.Username);
                    errors.Add("Your account is locked out. Please try again later.");
                }
                else if (result.IsNotAllowed)
                {
                    Logger.LogWarning("User login not allowed for email: {Email}", student.Username);
                    errors.Add("Login is not allowed. Please confirm your email or contact support.");
                }
                else
                {
                    Logger.LogWarning("Invalid login attempt for email: {Email}", student.Username);
                    errors.Add("Invalid email or password.");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred during login for email: {Email}", student!.Username);
            errors.Add("An unexpected error occurred. Please try again later.");
        }
    }

    private async Task HandleEducatorLogin()
    {
        errors.Clear();

        try
        {
            Logger.LogInformation("User login attempt for email: {Email}", educator!.Username);
            var result = await SignInManager.PasswordSignInAsync(educator.Username, educator.Password, isPersistent: false, lockoutOnFailure:
            false);

            if (result.Succeeded)
            {
                Logger.LogInformation("User login successful for email: {Email}", educator.Username);
                Navigation.NavigateTo("/");
            }
            else
            {
                if (result.IsLockedOut)
                {
                    Logger.LogWarning("User account locked out for email: {Email}", educator.Username);
                    errors.Add("Your account is locked out. Please try again later.");
                }
                else if (result.IsNotAllowed)
                {
                    Logger.LogWarning("User login not allowed for email: {Email}", educator.Username);
                    errors.Add("Login is not allowed. Please confirm your email or contact support.");
                }
                else
                {
                    Logger.LogWarning("Invalid login attempt for email: {Email}", educator.Username);
                    errors.Add("Invalid email or password.");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred during login for email: {Email}", educator!.Username);
            errors.Add("An unexpected error occurred. Please try again later.");
        }
    }

}
