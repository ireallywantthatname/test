@page "/login"
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@using Test.Models
@inject TestDbContext DbContext

<PageTitle>Login | Test</PageTitle>

<div class="flex flex-col items-center justify-center min-h-screen p-4">
    <h1 class="text-3xl font-bold mb-4">Login</h1>
    <hr class="w-48 h-0.5 mx-auto bg-slate-900 rounded-sm mb-8">

    @if (errors.Any())
    {
        <div class="w-full max-w-md bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            @foreach (var error in errors)
            {
                <p class="text-sm">@error</p>
            }
        </div>
    }

    @if (Role == "student")
    {
        <div class="w-full max-w-md">
            <EditForm Model="studentModel" OnSubmit="HandleStudentLogin" FormName="studentLoginForm" method="post">
                <div class="mb-6">
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                    <InputText id="username" @bind-Value="studentModel!.Username" required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500" />
                </div>

                <div class="mb-6">
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <InputText id="password" @bind-Value="studentModel!.Password" type="password" required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500" />
                </div>

                <button type="submit"
                    class="w-full bg-slate-900 text-white py-2 px-4 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                    Student Login
                </button>
            </EditForm>
        </div>
    }
    else if (Role == "educator")
    {
        <div class="w-full max-w-md">
            <EditForm Model="educatorModel" OnSubmit="HandleEducatorLogin" FormName="educatorLoginForm" method="post">
                <div class="mb-6">
                    <label for="educatorUsername" class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                    <InputText id="educatorUsername" @bind-Value="educatorModel!.Username" required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500" />
                </div>

                <div class="mb-6">
                    <label for="educatorPassword" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <InputText id="educatorPassword" @bind-Value="educatorModel.Password" type="password" required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500" />
                </div>

                <button type="submit"
                    class="w-full bg-slate-900 text-white py-2 px-4 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                    Educator Login
                </button>
            </EditForm>
        </div>
    }
    else {
        Navigation.NavigateTo("/");
    }
</div>

@code {
    [Parameter]
    public string? Role { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromForm]
    public Student? studentModel { get; set; } = new Student();

    [SupplyParameterFromForm]
    public Educator? educatorModel { get; set; } = new Educator();

    private List<string> errors = new List<string>();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        // Parse query parameters
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        // Set role from query parameter
        if (query.TryGetValue("role", out var roleValue))
        {
            Role = roleValue.ToString().ToLower();
        }
        
        // Handle error messages
        if (query.TryGetValue("error", out var errorValue))
        {
            switch (errorValue.ToString())
            {
                case "invalid":
                    errors.Add("Invalid username or password.");
                    break;
                case "locked":
                    errors.Add("Your account is locked out. Please try again later.");
                    break;
                case "notallowed":
                    errors.Add("Login is not allowed. Please confirm your email or contact support.");
                    break;
                case "notfound":
                    errors.Add("User not found. Please check your credentials.");
                    break;
                case "unexpected":
                    errors.Add("An unexpected error occurred. Please try again later.");
                    break;
            }
        }
        else {
            studentModel ??= new();
            educatorModel ??= new();
        }
    }

    private async Task HandleStudentLogin()
    {
        Role = "student";
        
        // Debug to verify values
        Logger.LogInformation($"Attempting login with Username: {studentModel?.Username}, Password length: {studentModel?.Password?.Length ?? 0}");
        
        // Check for null values first
        if (string.IsNullOrEmpty(studentModel!.Username) || string.IsNullOrEmpty(studentModel.Password))
        {
            Logger.LogWarning("Login attempted with null or empty credentials");
            Navigation.NavigateTo("/login?role=student&error=invalid", forceLoad: true);
            return;
        }
        
        // First validate against your custom Student model
        var dbStudent = await DbContext.Students
            .FirstOrDefaultAsync(s => s.Username == studentModel.Username);
        
        if (dbStudent == null)
        {
            // Student not found in custom database
            Logger.LogWarning("Student not found in custom database: {Username}", studentModel.Username);
            Navigation.NavigateTo("/login?role=student&error=notfound", forceLoad: true);
            return;
        }
        
        // Check password separately (better approach for debugging)
        if (dbStudent.Password != studentModel.Password)
        {
            Logger.LogWarning("Invalid password for username: {Username}", studentModel.Username);
            Navigation.NavigateTo("/login?role=student&error=invalid", forceLoad: true);
            return;
        }
        
        // Then proceed with Identity authentication
        await ProcessLogin(studentModel.Username, studentModel.Password);
    }

    private async Task HandleEducatorLogin()
    {
        Role = "educator";
        
        // First validate against your custom Educator model
        var dbEducator = await DbContext.Educators
            .FirstOrDefaultAsync(e => e.Username == educatorModel!.Username && e.Password == educatorModel.Password);
            
        if (dbEducator == null)
        {
            // Educator not found in custom database
            Logger.LogWarning("Educator not found in custom database: {Username}", educatorModel!.Username);
            Navigation.NavigateTo("/login?role=educator&error=notfound", forceLoad: true);
            return;
        }
        
        // Then proceed with Identity authentication
        await ProcessLogin(educatorModel!.Username, educatorModel.Password);
    }

    private bool shouldRedirect = false;
    private string redirectUrl = string.Empty;

    // Handle the form submission
    private async Task ProcessLogin(string username, string password)
    {
        try
        {
            Logger.LogInformation("User login attempt for username: {Username}", username);
            
            var result = await SignInManager.PasswordSignInAsync(
                username, 
                password, 
                isPersistent: false, 
                lockoutOnFailure: false);

            if (result.Succeeded)
            {
                Logger.LogInformation("User login successful for username: {Username}", username);
                if (Role == "student")
                {
                    redirectUrl = "/";
                }
                else
                {
                    redirectUrl = "/create";
                }
                shouldRedirect = true;
            }
            else
            {
                // Handle login failure
                var errorParam = result.IsLockedOut ? "locked" : 
                                result.IsNotAllowed ? "notallowed" : "invalid";
                                
                redirectUrl = $"/login?role={Role}&error={errorParam}";
                shouldRedirect = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred during login for username: {Username}", username);
            redirectUrl = $"/login?role={Role}&error=unexpected";
            shouldRedirect = true;
        }
    }
}

@if (shouldRedirect)
{
    <div class="flex flex-col items-center justify-center min-h-screen p-4">
        <h3>Redirecting...</h3>
        <meta http-equiv="refresh" content="0;url=@redirectUrl" />
    </div>
}