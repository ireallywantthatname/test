@page "/assistant"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AuthenticatedOnly")]
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject ILogger<Assistant> Logger

<PageTitle>AI Assistant Feedback History</PageTitle>

<div class="flex flex-col items-center justify-center min-h-screen p-4">

    @if (loading)
    {
        <div class="flex justify-center items-center p-12">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-slate-600"></div>
        </div>
    }
    else if (isEducator)
    {
        <div class="flex justify-center items-center w-md">
            <div class="text-red-700 border-2 border-dashed border-red-300 p-5 rounded-lg text-center w-md">
                <h2 class="text-lg font-semibold mb-2">Not Available</h2>
                <p class="text-base mb-2">This feature is only available for students.</p>
                <p class="text-sm mb-4">Educators can create and manage quizzes but cannot use the AI Assistant.</p>
            </div>
        </div>
    }
    else if (feedbacks.Count == 0)
    {
        <div class="text-center py-8 border-2 border-dashed border-slate-300 rounded-lg w-md">
            <h1 class="text-lg font-semibold mb-2">No Feedback Yet</h1>
            <div class="max-w-md mx-auto">
                <p class="text-lg text-slate-600 mb-2"></p>
                <p class="text-base mb-2">You haven't received any AI feedback yet.</p>
                <p class="text-sm mb-4">Complete a quiz to get personalized AI feedback.</p>
                <button @onclick='() => Navigation.NavigateTo("/quiz-list")'
                    class="px-4 py-2 bg-slate-900 text-white rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2">
                    Browse Available Quizzes
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold mb-4">
                Previous Feedbacks
            </h1>
            <hr class="w-48 h-0.5 mx-auto bg-slate-950 rounded-sm mb-8">
        </div>
        <div class="grid grid-cols-1 gap-6 max-w-3xl mx-auto">
            @foreach (var feedback in feedbacks)
            {
                <div class="bg-white rounded-lg overflow-hidden w-lg">
                    <div class="px-4 py-3">
                        <div class="flex justify-between items-center">
                            <h2 class="text-xl font-semibold">@feedback.QuizName</h2>
                            <div class="text-sm">
                                @feedback.CreatedAt.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                    <div class="p-5">
                        <div class="mb-4">
                            <p class="text-slate-600 text-sm">@feedback.QuizDescription</p>
                        </div>
                        <div class="flex items-center mb-4">
                            <div class="bg-slate-100 px-3 py-1 rounded-md">
                                <span class="text-slate-700">Score: </span>
                                <span class="font-bold">@feedback.Score</span>
                                <span class="text-slate-700"> / @feedback.TotalPossibleScore</span>
                                <span class="ml-2 text-slate-700">
                                    (@Math.Round((feedback.Score / feedback.TotalPossibleScore) * 100, 1)%)
                                </span>
                            </div>
                        </div>

                        <div class="border-2 border-dashed border-slate-300 text-slate-800 p-4 rounded-lg">
                            <div class="flex items-center mb-3">
                                <svg class="h-5 w-5 text-slate-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                    fill="currentColor">
                                    <path
                                        d="M17.7134 10.1281L17.4668 10.6938C17.2864 11.1079 16.7136 11.1079 16.5331 10.6938L16.2866 10.1281C15.8471 9.11947 15.0555 8.31641 14.0677 7.87708L13.308 7.53922C12.8973 7.35653 12.8973 6.75881 13.308 6.57612L14.0252 6.25714C15.0384 5.80651 15.8442 4.97373 16.2761 3.93083L16.5293 3.31953C16.7058 2.89349 17.2942 2.89349 17.4706 3.31953L17.7238 3.93083C18.1558 4.97373 18.9616 5.80651 19.9748 6.25714L20.6919 6.57612C21.1027 6.75881 21.1027 7.35653 20.6919 7.53922L19.9323 7.87708C18.9445 8.31641 18.1529 9.11947 17.7134 10.1281ZM2.82843 12.0001L7.07107 16.2428L5.65685 17.657L0 12.0001L5.65685 6.34326L7.07107 7.75748L2.82843 12.0001ZM18.3429 17.6572L23.9998 12.0003L21.1714 9.17188L19.7571 10.5861L21.1714 12.0003L16.9287 16.2429L18.3429 17.6572Z">
                                    </path>
                                </svg>
                                <h3 class="font-bold text-slate-800">AI Analysis & Feedback</h3>
                            </div>
                            <div class="pl-7">
                                <p class="text-slate-700 leading-relaxed">@feedback.FeedbackText</p>
                            </div>
                            <div class="mt-3 pl-7 text-xs text-slate-500">
                                <em>Generated by AI based on your quiz performance</em>
                            </div>
                        </div>

                        <div class="mt-4 text-center">
                            <button @onclick='() => Navigation.NavigateTo("/quiz-list")'
                                class="px-4 py-2 bg-slate-950 text-white rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                                Retry
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>