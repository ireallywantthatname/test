@page "/assistant"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AuthenticatedOnly")]
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject ILogger<Assistant> Logger

<PageTitle>AI Assistant Feedback History</PageTitle>

<div class="container mx-auto px-4 py-16">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold">AI Assistant Feedback History</h1>
        <hr class="w-48 h-0.5 mx-auto bg-slate-900 rounded-sm mb-6">
    </div>

    @if (loading)
    {
        <div class="flex justify-center items-center p-12">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-slate-600"></div>
        </div>
    }
    else if (isEducator)
    {
        <div class="flex justify-center items-center">
            <div class="bg-red-100 border border-red-400 text-red-700 p-5 rounded-lg shadow-md text-center max-w-md">
                <h2 class="text-lg font-semibold mb-2">Access Denied</h2>
                <p class="text-base mb-2">This feature is only available for students.</p>
                <p class="text-sm mb-4">Educators can create and manage quizzes but cannot use the AI Assistant.</p>
                <button @onclick='() => Navigation.NavigateTo("/dashboard")'
                    class="px-3 py-1.5 bg-slate-900 text-white text-sm rounded-md hover:bg-slate-800">
                    Return to Dashboard
                </button>
            </div>
        </div>
    }
    else if (feedbacks.Count == 0)
    {
        <div class="text-center py-8">
            <h1 class="text-xl font-bold mb-5 text-slate-950">No Feedback Yet</h1>
            <div class="max-w-md mx-auto">
                <p class="text-lg text-gray-600 mb-3">You haven't received any AI feedback yet.</p>
                <p class="text-base text-gray-600 mb-6">Complete a quiz to get personalized AI feedback.</p>
                <button @onclick='() => Navigation.NavigateTo("/quiz-list")'
                    class="px-4 py-2 bg-slate-900 text-white rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2">
                    Browse Available Quizzes
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 max-w-3xl mx-auto">
            @foreach (var feedback in feedbacks)
            {
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="bg-slate-800 px-4 py-3 text-white">
                        <div class="flex justify-between items-center">
                            <h2 class="text-xl font-semibold">@feedback.QuizName</h2>
                            <div class="text-sm">
                                @feedback.CreatedAt.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                    <div class="p-5">
                        <div class="mb-4">
                            <p class="text-gray-600 text-sm">@feedback.QuizDescription</p>
                        </div>
                        <div class="flex items-center mb-4">
                            <div class="bg-slate-100 px-3 py-1 rounded-md">
                                <span class="text-slate-700">Score: </span>
                                <span class="font-bold">@feedback.Score</span>
                                <span class="text-slate-700"> / @feedback.TotalPossibleScore</span>
                                <span class="ml-2 text-slate-700">
                                    (@Math.Round((feedback.Score / feedback.TotalPossibleScore) * 100, 1)%)
                                </span>
                            </div>
                        </div>

                        <div class="bg-slate-50 border border-slate-300 text-slate-800 p-4 rounded-lg">
                            <div class="flex items-center mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-600 mr-2" fill="none"
                                    viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                </svg>
                                <h3 class="font-bold text-slate-800">AI Analysis & Feedback</h3>
                            </div>
                            <div class="pl-7">
                                <p class="text-slate-700 leading-relaxed">@feedback.FeedbackText</p>
                            </div>
                            <div class="mt-3 pl-7 text-xs text-slate-500">
                                <em>Generated by AI based on your quiz performance</em>
                            </div>
                        </div>

                        <div class="mt-4 text-right">
                            <button @onclick='() => Navigation.NavigateTo("/quiz-list")'
                                class="px-4 py-2 bg-slate-600 text-white rounded-md hover:bg-slate-700">
                                Take Quiz Again
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>