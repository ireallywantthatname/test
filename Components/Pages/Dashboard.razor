@page "/Dashboard"
@rendermode InteractiveServer
@using Test.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize(Policy = "AuthenticatedOnly")]
@inject TestDbContext DbContext
@inject UserManager<IdentityUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard | Test</PageTitle>

<div class="flex flex-col items-center justify-center min-h-screen p-12">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold m-2">Dashboard</h1>
            <hr class="w-48 h-0.5 mx-auto bg-slate-950 rounded-sm">
        </div>
    @if (loading)
    {
        <div class="flex items-center justify-center">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-slate-900"></div>
        </div>
    }
    else
    {
        <div class="flex flex-col md:flex-row sm:flex-col items-center justify-center">
            <!-- Action Buttons Grid -->
            <div class="size-80 bg-white m-2 rounded p-6 flex flex-col items justify-center">
                <h3 class="text-xl font-bold mb-4 text-slate-950 text-center">Quick Actions</h3>

                @if (userType == "Educator")
                {
                    <!-- Create Quiz -->
                    <div class="bg-white rounded mb-4">
                        <button @onclick="NavigateToQuizCreate"
                            class="w-full h-full flex items-center justify-center p-4 text-slate-900 border border-slate-900 rounded-md hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                            <div class="text-center">
                                <svg class="h-8 w-8 mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                    fill="currentColor">
                                    <path
                                        d="M13.0001 10.9999L22.0002 10.9997L22.0002 12.9997L13.0001 12.9999L13.0001 21.9998L11.0001 21.9998L11.0001 12.9999L2.00004 13.0001L2 11.0001L11.0001 10.9999L11 2.00025L13 2.00024L13.0001 10.9999Z">
                                    </path>
                                </svg>
                                <h3 class="text-lg font-semibold text-slate-800">Create Quiz</h3>
                                <p class="text-sm text-slate-800">Design new assessments</p>
                            </div>
                        </button>
                    </div>
                }

                <!-- Quiz List -->
                <div class="bg-white rounded">
                    <button @onclick="NavigateToQuizList"
                        class="w-full h-full flex items-center justify-center p-4 text-slate-900 border border-slate-900 rounded-md hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200">
                        <div class="text-center">
                            <svg class="h-8 w-8 mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                fill="currentColor">
                                <path
                                    d="M3 8L9.00319 2H19.9978C20.5513 2 21 2.45531 21 2.9918V21.0082C21 21.556 20.5551 22 20.0066 22H3.9934C3.44476 22 3 21.5501 3 20.9932V8ZM10 3.5L4.5 9H10V3.5Z">
                                </path>
                            </svg>
                            <h3 class="text-lg font-semibold text-slate-800">
                                @(userType == "Educator" ? "My Quizzes" : "Available Quizzes")
                            </h3>
                            <p class="text-sm text-slate-800">
                                @(userType == "Educator" ? "Manage your assessments" : "Take assessments")
                            </p>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Activity Card -->
            <div class="size-80 bg-white m-2 rounded p-6 flex flex-col items-center justify-center">
                @if (userType == "Educator")
                {
                    <h3 class="text-xl font-bold mb-4 text-slate-950 text-center">Stats</h3>

                    <div class="space-y-4">
                        <div class="pl-4">
                            <p class="text-sm text-slate-800 text-center">Total Quizzes Created</p>
                            <p class="text-2xl font-bold text-slate-800 text-center">@totalQuizzesCreated</p>
                        </div>

                        <div class="pl-4">
                            <p class="text-sm text-slate-800 text-center">Total Questions Created</p>
                            <p class="text-2xl font-bold text-slate-800 text-center">@totalQuestionsCreated</p>
                        </div>

                        @if (lastCreatedQuiz != null)
                        {
                            <div class="pl-4">
                                <p class="text-sm text-slate-800 text-center">Last Quiz Created</p>
                                <p class="text-lg font-semibold text-slate-800 text-center">@lastCreatedQuiz.QuizName</p>
                                <p class="text-sm text-slate-800 text-center">@lastCreatedQuiz.QuizDescription</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <h3 class="text-xl font-bold mb-4 text-slate-950 text-center">Your Quiz Activity</h3>

                    <div class="space-y-4">
                        <div class="pl-4">
                            <p class="text-sm text-slate-800 text-center">Total Attempts</p>
                            <p class="text-2xl font-bold text-slate-800 text-center">@totalAttempts</p>
                        </div>

                        @if (totalAttempts > 0)
                        {
                            <div class="pl-4">
                                <p class="text-sm text-slate-800 text-center">Average Score</p>
                                <p class="text-2xl font-bold text-slate-800 text-center">@Math.Round(averageScore, 1)</p>
                            </div>
                        }

                        @if (recentAttempts.Any())
                        {
                            <div class="pl-4">
                                <p class="text-sm text-slate-800 text-center">Recent Attempts</p>
                                <div class="space-y-2 mt-2">
                                    @foreach (var attempt in recentAttempts.Take(3))
                                    {
                                        <div class="text-sm text-center">
                                            <p class="font-medium text-slate-800">@attempt.Quiz?.QuizName</p>
                                            <p class="text-slate-800">Score: @attempt.TotalScore</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- User Information Card -->
            <div class="size-80 bg-white m-2 rounded p-6 flex flex-col items justify-center">
                <h3 class="text-xl font-bold mb-4 text-slate-950 text-center">User Information</h3>

                <div class="space-y-4">
                    <div class="pl-4">
                        <p class="text-sm text-slate-800 text-center">Username</p>
                        <p class="text-lg font-semibold text-slate-800 text-center">@username</p>
                    </div>

                    <div class="pl-4">
                        <p class="text-sm text-slate-800 text-center">Account Type</p>
                        <p class="text-lg font-semibold text-slate-800 text-center">@userType</p>
                    </div>

                    <div class="pl-4">
                        <p class="text-sm text-slate-800 text-center">User ID</p>
                        <p class="text-lg font-semibold text-slate-800 text-center">@currentUserId</p>
                    </div>

                    <div class="mt-6">
                        <button @onclick='() => Navigation.NavigateTo("/logout")'
                            class="w-full px-4 py-2 text-red-600 border border-red-600 rounded-md hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors duration-200">
                            Sign Out
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>