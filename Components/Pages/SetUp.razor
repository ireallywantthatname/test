@page "/"
@rendermode InteractiveServer
@using Test.Types

@if (!IsStarted)
{
    <PageTitle>Home | Test</PageTitle>

    <div class="flex flex-col items-center justify-center min-h-screen">
        <div class="font-bold text-6xl md:text-8xl sm:text-6xl m-4">Test</div>
        <hr class="w-48 h-0.5 mx-auto bg-slate-900 rounded-sm mb-8">
        <div class="text-2xl md:text-4xl sm:text-2xl animate-bounce text-center">The fastest online
            examination system on Earth.</div>
        <button @onclick="() => IsStarted = true"
            class="w-32 bg-slate-900 text-white py-2 px-4 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200 my-4">Get
            Started</button>
    </div>
}
else
{
    <PageTitle>Choice | Test</PageTitle>

    <div class="flex flex-col sm:flex-col md:flex-row items-center justify-center min-h-screen gap-20 p-10 sm:p-10 md:p-20">
        @foreach (var choice in Choices) {
        <div class="flex flex-col items-center justify-center md:p-auto">
            <div class="font-semibold text-2xl md:text-4xl sm:text-2xl m-4">@choice.Title
            </div>
            <hr class="w-48 h-0.5 mx-auto bg-slate-900 rounded-sm mb-8">
            <p class="text-center text-xl">@choice.Details</p>
            <button @onclick="@choice.EventHandler"
                class="w-32 bg-slate-900 text-white py-2 px-4 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors duration-200 my-4">Sign
                up</button>
        </div>
        }
    </div>
}

@code {
    private bool IsStarted = false;
    private readonly List<Choice> Choices = new List<Choice>();

    protected override void OnInitialized()
    {
        Choices.Add(new Choice
        {
            Title = "For Student",
            Details = "Register here to establish your student account. This will enable you to access the online examination platform, participate in assessments, track your progress, and utilize educational resources.",
            EventHandler = () => Navigation.NavigateTo("/register")
        });

        Choices.Add(new Choice
        {
            Title = "For Educators",
            Details = "Register here to create your educator account. This will allow you to design and administer courses, configure assessments, and manage student interactions.",
            EventHandler = () => Navigation.NavigateTo("/register")
        });
    }
}
